{
  "$schema": "./cases.schema.json",
  "version": "0.1.0",
  "note": "guji-markdown 一致性测试语料。任何平台的实现都应通过这里的全部用例，见 ../conformance.md。",
  "cases": [
    {
      "name": "jz/basic",
      "note": "夹注基本用法",
      "guji": "子曰<孔子也>：學而時習之。",
      "directive": "子曰:jz[孔子也]：學而時習之。",
      "html": "<p>子曰<span class=\"guji-jz\">孔子也</span>：學而時習之。</p>"
    },
    {
      "name": "jz/multiple",
      "guji": "不亦說乎<悅也>，不亦樂乎<音洛>。",
      "directive": "不亦說乎:jz[悅也]，不亦樂乎:jz[音洛]。",
      "html": "<p>不亦說乎<span class=\"guji-jz\">悅也</span>，不亦樂乎<span class=\"guji-jz\">音洛</span>。</p>"
    },
    {
      "name": "jz/nested",
      "note": "夹注可嵌套",
      "guji": "正文<注文<再注>>",
      "directive": "正文:jz[注文:jz[再注]]",
      "html": "<p>正文<span class=\"guji-jz\">注文<span class=\"guji-jz\">再注</span></span></p>"
    },
    {
      "name": "jz/html-tag",
      "note": "`<` 后为 ASCII 字母，仍是原始 HTML",
      "guji": "甲<span>乙</span>丙",
      "directive": "甲<span>乙</span>丙",
      "html": "<p>甲乙丙</p>"
    },
    {
      "name": "jz/autolink",
      "note": "自动链接不受影响",
      "guji": "見<https://example.com/a/b>。",
      "directive": "見<https://example.com/a/b>。",
      "html": "<p>見<a href=\"https://example.com/a/b\">https://example.com/a/b</a>。</p>"
    },
    {
      "name": "jz/comparison",
      "note": "`<` 后为空白，按字面",
      "guji": "a < b 且 b > c",
      "directive": "a < b 且 b > c",
      "html": "<p>a &#x3C; b 且 b > c</p>"
    },
    {
      "name": "jz/unclosed",
      "note": "未闭合即字面",
      "guji": "子曰<孔子也",
      "directive": "子曰<孔子也",
      "html": "<p>子曰&#x3C;孔子也</p>"
    },
    {
      "name": "jz/cross-line",
      "note": "记号不跨行",
      "guji": "子曰<孔子\n也>",
      "directive": "子曰<孔子\n也>",
      "html": "<p>子曰&#x3C;孔子\n也></p>"
    },
    {
      "name": "jz/escape",
      "note": "反斜杠转义",
      "guji": "此處用 \\<尖括號\\>",
      "directive": "此處用 \\<尖括號\\>",
      "html": "<p>此處用 &#x3C;尖括號></p>"
    },
    {
      "name": "jz/label-bracket",
      "note": "不配对的方括号必须转义",
      "guji": "正文<注[未閉合>",
      "directive": "正文:jz[注\\[未閉合]",
      "html": "<p>正文<span class=\"guji-jz\">注[未閉合</span></p>"
    },
    {
      "name": "jz/label-link",
      "note": "配对的方括号保持原样",
      "guji": "正文<見[說文](s.html)>",
      "directive": "正文:jz[見[說文](s.html)]",
      "html": "<p>正文<span class=\"guji-jz\">見<a href=\"s.html\">說文</a></span></p>"
    },
    {
      "name": "bz/basic",
      "guji": "帝曰((朕))知之矣。",
      "directive": "帝曰:bz[朕]知之矣。",
      "html": "<p>帝曰<ins class=\"guji-bz\">朕</ins>知之矣。</p>",
      "note": "单纯添甲：底本无、定本有"
    },
    {
      "name": "sz/basic",
      "guji": "帝曰知{{之}}之矣。",
      "directive": "帝曰知:sz[之]之矣。",
      "html": "<p>帝曰知<del class=\"guji-sz\">之</del>之矣。</p>",
      "note": "单纯删甲：底本有、定本无"
    },
    {
      "name": "bz/single-paren",
      "note": "单层括号无特殊含义",
      "guji": "此(非補字)也",
      "directive": "此(非補字)也",
      "html": "<p>此(非補字)也</p>"
    },
    {
      "name": "sz/single-brace",
      "guji": "此{非刪字}也",
      "directive": "此{非刪字}也",
      "html": "<p>此{非刪字}也</p>"
    },
    {
      "name": "bz/sz/adjacent",
      "guji": "本作((甲)){{乙}}",
      "directive": "本作:bz[甲]:sz[乙]",
      "html": "<p>本作<ins class=\"guji-bz\">甲</ins><del class=\"guji-sz\">乙</del></p>"
    },
    {
      "name": "bz/nested",
      "guji": "((補((再補))))",
      "directive": ":bz[補:bz[再補]]",
      "html": "<p><ins class=\"guji-bz\">補<ins class=\"guji-bz\">再補</ins></ins></p>"
    },
    {
      "name": "bz/unclosed",
      "guji": "((未閉合",
      "directive": "((未閉合",
      "html": "<p>((未閉合</p>"
    },
    {
      "name": "gz/basic",
      "note": "以甲改乙：改字 + 紧随其后的删字",
      "guji": "原作[甲]{{乙}}。",
      "directive": "原作:gz[甲]:sz[乙]。",
      "html": "<p>原作<ins class=\"guji-gz\">甲</ins><del class=\"guji-sz\">乙</del>。</p>"
    },
    {
      "name": "gz/standalone",
      "note": "改字本身是独立记号，不要求相邻删字",
      "guji": "[甲]",
      "directive": ":gz[甲]",
      "html": "<p><ins class=\"guji-gz\">甲</ins></p>"
    },
    {
      "name": "gz/nested",
      "note": "内容递归解析",
      "guji": "[《論語》]{{《論语》}}",
      "directive": ":gz[:sm[論語]]:sz[:sm[論语]]",
      "html": "<p><ins class=\"guji-gz\"><span class=\"guji-sm\"><span class=\"guji-sm-mark\">《</span>論語<span class=\"guji-sm-mark\">》</span></span></ins><del class=\"guji-sz\"><span class=\"guji-sm\"><span class=\"guji-sm-mark\">《</span>論语<span class=\"guji-sm-mark\">》</span></span></del></p>"
    },
    {
      "name": "gz/in-jz",
      "guji": "正文<[甲]{{乙}}>",
      "directive": "正文:jz[:gz[甲]:sz[乙]]",
      "html": "<p>正文<span class=\"guji-jz\"><ins class=\"guji-gz\">甲</ins><del class=\"guji-sz\">乙</del></span></p>"
    },
    {
      "name": "gz/with-src",
      "note": "校勘依据用 src 属性",
      "guji": ":gz[甲]{src=據宋本}:sz[乙]",
      "directive": ":gz[甲]{src=據宋本}:sz[乙]",
      "html": "<p><ins class=\"guji-gz\" data-guji-src=\"據宋本\">甲</ins><del class=\"guji-sz\">乙</del></p>"
    },
    {
      "name": "gz/inline-link",
      "note": "`]` 后为 `(`，是行内链接",
      "guji": "[說文](s.html)",
      "directive": "[說文](s.html)",
      "html": "<p><a href=\"s.html\">說文</a></p>"
    },
    {
      "name": "gz/ref-link",
      "note": "`]` 后为 `[`，是引用式链接",
      "guji": "[說文][1]",
      "directive": "[說文][1]",
      "html": "<p>[說文][1]</p>"
    },
    {
      "name": "gz/link-definition",
      "note": "`]` 后为 `:`，是链接定义",
      "guji": "[說文]: https://example.org",
      "directive": "[說文]: https://example.org",
      "html": ""
    },
    {
      "name": "gz/footnote",
      "note": "`[` 后为 `^`，是脚注",
      "guji": "腳註[^1]",
      "directive": "腳註[^1]",
      "html": "<p>腳註[^1]</p>"
    },
    {
      "name": "gz/task-list-open",
      "note": "内容紧邻空白",
      "guji": "- [ ] 未完成",
      "directive": "- [ ] 未完成",
      "html": "<ul>\n<li>[ ] 未完成</li>\n</ul>"
    },
    {
      "name": "gz/task-list-done",
      "note": "内容无 CJK",
      "guji": "- [x] 已完成",
      "directive": "- [x] 已完成",
      "html": "<ul>\n<li>[x] 已完成</li>\n</ul>"
    },
    {
      "name": "gz/reserved-double",
      "note": "`[[…]]` 预留给阙文",
      "guji": "[[闕文]]",
      "directive": "[[闕文]]",
      "html": "<p>[[闕文]]</p>"
    },
    {
      "name": "gz/directive-label",
      "note": "`[` 前为 ASCII 字母，是指令 label",
      "guji": ":jz[孔子也]",
      "directive": ":jz[孔子也]",
      "html": "<p><span class=\"guji-jz\">孔子也</span></p>"
    },
    {
      "name": "gz/no-cjk",
      "guji": "見 [abc] 者",
      "directive": "見 [abc] 者",
      "html": "<p>見 [abc] 者</p>"
    },
    {
      "name": "gz/spaced",
      "guji": "[ 甲 ]",
      "directive": "[ 甲 ]",
      "html": "<p>[ 甲 ]</p>"
    },
    {
      "name": "gz/unclosed",
      "guji": "[甲",
      "directive": "[甲",
      "html": "<p>[甲</p>"
    },
    {
      "name": "gz/escape",
      "guji": "\\[甲\\]",
      "directive": "\\[甲\\]",
      "html": "<p>[甲]</p>"
    },
    {
      "name": "mixed/jiaokan-three",
      "note": "校勘三式各有各的记号与颜色",
      "guji": "改：[甲]{{乙}}；刪：{{丙}}；補：((丁))。",
      "directive": "改：:gz[甲]:sz[乙]；刪：:sz[丙]；補：:bz[丁]。",
      "html": "<p>改：<ins class=\"guji-gz\">甲</ins><del class=\"guji-sz\">乙</del>；刪：<del class=\"guji-sz\">丙</del>；補：<ins class=\"guji-bz\">丁</ins>。</p>"
