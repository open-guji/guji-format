{
  "name": "@open-guji/markdown-web",
  "version": "0.3.0",
  "description": "古籍 Markdown 的网页解析器：HTML 渲染与横排 / 竖排样式",
  "keywords": [
    "markdown",
    "html",
    "remark",
    "rehype",
    "古籍",
    "guji",
    "chinese",
    "classics",
    "vertical-writing"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-guji/guji-markdown.git",
    "directory": "packages/web"
  },
  "homepage": "https://github.com/open-guji/guji-markdown/tree/main/packages/web",
  "bugs": "https://github.com/open-guji/guji-markdown/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles/guji.css": "./styles/guji.css",
    "./styles/guji-vertical.css": "./styles/guji-vertical.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:styles": "node scripts/build-styles.mjs",
    "build": "npm run build:styles && tsc -p tsconfig.json",
    "typecheck": "npm run build:styles && tsc -p tsconfig.json --noEmit",
    "test": "npm run build:styles && vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@open-guji/markdown-core": "workspace:^",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "mdast-util-to-hast": "^13.2.1",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
