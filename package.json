{
  "name": "guji-markdown-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "古籍 Markdown 扩展：规范、网页解析器与 PDF 生成器",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "test": "pnpm -r --filter \"./packages/*\" run test",
    "typecheck": "pnpm -r --filter \"./packages/*\" run typecheck",
    "clean": "pnpm -r exec rm -rf dist *.tsbuildinfo",
    "demo": "pnpm --filter @open-guji/markdown-web run build && node examples/build-demo.mjs",
    "release:check": "pnpm build && pnpm test && node scripts/release-check.mjs",
    "release": "pnpm publish -r --access public",
    "docs:sample": "node scripts/render-sample.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
