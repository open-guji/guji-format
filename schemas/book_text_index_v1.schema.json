{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-guji.org/schema/book-text/index/v1.json",
  "title": "BookTextVersionIndex",
  "description": "book-text 版本目录的 index.json（章目录与本版本元数据）；三种 kind 的字段见 spec/07 §三。本 schema 只约束各 kind 共有的结构与 original 章条目",
  "type": "object",
  "required": [
    "chapters"
  ],
  "properties": {
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "n",
          "file",
          "title"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "file": {
            "type": "string",
            "pattern": "^\\d{3,}$"
          },
          "title": {
            "type": "string"
          },
          "has_json": {
            "type": "boolean"
          },
          "char_file": {
            "type": "string",
            "pattern": "^\\d{3,}\\.char\\.json$"
          },
          "cord_file": {
            "type": "string",
            "pattern": "^\\d{3,}\\.cord\\.json$"
          },
          "punct_file": {
            "type": "string",
            "pattern": "^\\d{3,}\\.punct\\.json$"
          },
          "entity_file": {
            "type": "string",
            "pattern": "^\\d{3,}\\.entity\\.json$"
          },
          "norm_file": {
            "type": "string",
            "pattern": "^\\d{3,}\\.norm\\.json$"
          },
          "decision_file": {
            "type": "string",
            "pattern": "^\\d{3,}\\.decision\\.json$"
          },
          "lines_file": {
            "type": "string",
            "pattern": "^\\d{3,}\\.lines\\.md$",
            "description": "只在 derived 分支"
          },
          "rich_file": {
            "type": "string",
            "pattern": "^\\d{3,}\\.rich\\.md$",
            "description": "只在 derived 分支"
          },
          "text_version": {
            "type": "string",
            "pattern": "^[0-3]\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
          },
          "punct_version": {
            "type": "string",
            "pattern": "^[0-3]\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
          },
          "entity_version": {
            "type": "string",
            "pattern": "^[0-3]\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
          },
          "pages": {
            "type": "string",
            "pattern": "^\\d+-\\d+$"
          },
          "md_len": {
            "type": "integer",
            "minimum": 0
          },
          "page_title": {
            "type": "string"
          },
          "revid": {
            "type": "integer"
          },
          "juan": {
            "type": "string"
          },
          "volume": {
            "type": "integer"
          },
          "pdf_pages": {
            "type": "string"
          },
          "has_table": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "anyOf": [
                {
                  "required": [
                    "char_file"
                  ]
                },
                {
                  "required": [
                    "text_version"
                  ]
                }
              ]
            },
            "then": {
              "required": [
                "char_file",
                "text_version"
              ]
            }
          },
          {
            "if": {
              "required": [
                "punct_file"
              ]
            },
            "then": {
              "required": [
                "punct_version"
              ]
            }
          },
          {
            "if": {
              "required": [
                "entity_file"
              ]
            },
            "then": {
              "required": [
                "entity_version"
              ]
            }
          }
        ]
      }
    },
    "total_chapters": {
      "type": "integer",
      "minimum": 0
    },
    "total_entries": {
      "type": "integer",
      "minimum": 0
    },
    "work_id": {
      "type": "string"
    },
    "book_id": {
      "type": "string"
    },
    "version_label": {
      "type": "string"
    },
    "revision": {
      "type": "string",
      "description": "转录本存量字段不维护；整理本按 bump-collated 管；original 不用"
    },
    "revised_at": {
      "type": "string"
    },
    "fetched_at": {
      "type": "string"
    },
    "scraped_at": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "catalog",
        "anthology",
        "collated_edition",
        "kaozhen",
        "fragment_collection",
        "placeholder"
      ]
    },
    "text_quality": {
      "type": "object",
      "required": [
        "grade"
      ],
      "properties": {
        "grade": {
          "type": "string",
          "enum": [
            "source",
            "ocr",
            "rough",
            "fine",
            "none",
            "placeholder"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "name",
        "license"
      ]
    },
    "line_is_column": {
      "type": "boolean"
    },
    "guji_markdown": {
      "type": "string"
    },
    "other_sources": {
      "type": "array"
    }
  }
}
