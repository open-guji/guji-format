{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-guji.org/schema/entity/v0.1.json",
  "title": "GujiEntity",
  "description": "伴生层独立外挂命名实体与知识图谱链接格式 (guji-entity v0.1)",
  "type": "object",
  "required": ["$schema", "version", "book_id", "entities"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "book_id": {
      "type": "string"
    },
    "volume": {
      "type": "integer",
      "minimum": 1
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "creator": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "base_edition": { "type": "string" }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "text", "anchor"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["work", "people", "place", "office", "dynasty", "other"],
            "description": "实体类型"
          },
          "text": {
            "type": "string",
            "description": "实体原文底本汉字"
          },
          "anchor": {
            "type": "object",
            "required": ["start", "end"],
            "description": "权威起止拓扑格位锚点 <页>:<列>:<格>[子列]",
            "properties": {
              "start": {
                "type": "string",
                "pattern": "^\\d+:\\d+:-?\\d+[ab]?$"
              },
              "end": {
                "type": "string",
                "pattern": "^\\d+:\\d+:-?\\d+[ab]?$"
              }
            }
          },
          "span": {
            "type": "object",
            "description": "派生线性字符流偏移区间缓存 [start_offset, end_offset)",
            "required": ["start_offset", "end_offset"],
            "properties": {
              "start_offset": { "type": "integer", "minimum": 0 },
              "end_offset": { "type": "integer", "minimum": 0 }
            }
          },
          "target": {
            "type": "object",
            "description": "知识图谱对齐对象",
            "required": ["status"],
            "properties": {
              "status": {
                "type": "string",
                "enum": ["matched", "new_candidate", "external"],
                "description": "matched(已匹配收录) / new_candidate(新候选需建档) / external(外部网址)"
              },
              "entity_type": { "type": "string" },
              "entity_id": { "type": "string" },
              "canonical_name": { "type": "string" },
              "href": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "source": { "type": "string" }
        }
      }
    }
  }
}
