{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-guji.org/schema/punct/v0.1.json",
  "title": "GujiPunct",
  "description": "伴生层独立外挂标点格式 (guji-punct v0.1)，只用于 book-text original",
  "type": "object",
  "required": ["$schema", "version", "text_version", "book_id", "volume", "punctuations"],
  "if": {
    "properties": { "version": { "pattern": "^[2-3]\\." } },
    "required": ["version"]
  },
  "then": { "required": ["review"] },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-3]\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "description": "本层的内容版本（book-text original 三线版本号之一，MAJOR.MINOR.PATCH；major＝质量等级：1 可用／2 出版级／3 定本，0 只用于 wip，没有 3 以上）。不是格式版本，格式版本看 $schema"
    },
    "text_version": {
      "type": "string",
      "pattern": "^[0-3]\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "description": "本层是对着哪一版文本做的，即 original/index.json 该章的 text_version；不得超前于当前文本。文本线 major 同样是质量等级 0–3"
    },
    "review": {
      "type": "object",
      "description": "验收记录，本层 major ≥2 时必填",
      "required": ["date", "signed_by", "sample"],
      "properties": {
        "date": { "type": "string", "minLength": 1 },
        "signed_by": { "type": "string", "minLength": 1 },
        "sample": {
          "description": "抽检数据：样本量、一致率／精确率等；写成一句话或一个对象均可，不许为空",
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "object", "minProperties": 1 }
          ]
        }
      }
    },
    "book_id": {
      "type": "string"
    },
    "volume": {
      "type": "integer",
      "minimum": 1,
      "description": "册号，等于 book-text original/index.json 该章的 n"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "creator": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "base_edition": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "punctuations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["mark"],
        "properties": {
          "id": { "type": "string" },
          "mark": {
            "type": "string",
            "description": "全角标点：， 。 、 ； ： ？ ！ 「 」 『 』 《 》 —— …… （ ），分段符为 \\n\\n（spec/04 §四）"
          },
          "kind": {
            "type": "string",
            "enum": ["point", "break", "range"],
            "default": "point",
            "description": "point 点号与成对标号（成对标号拆成 before／after 两条）／break 自然段分段符；range 保留，不得使用（下次升版删）"
          },
          "pos": {
            "type": "string",
            "enum": ["after", "before", "range"],
            "default": "after",
            "description": "after 标点在锚点字之后；before 在之前（开引号、《）；range 保留，不得使用（下次升版删）"
          },
          "anchor": {
            "description": "基于格位的拓扑锚点。支持字符串键 '页:列:格[子列]' 或结构化对象，抬头超出上框时格位可为负数",
            "oneOf": [
              {
                "type": "string",
                "pattern": "^\\d+:\\d+:-?\\d+[ab]?$"
              },
              {
                "type": "object",
                "required": ["page", "line", "slot"],
                "properties": {
                  "volume": { "type": "integer", "minimum": 1 },
                  "page": { "type": "integer", "minimum": 1 },
                  "line": { "type": "integer", "minimum": 1 },
                  "slot": { "type": "integer", "description": "格位，抬头超框时可为负数" },
                  "lane": { "type": "string", "enum": ["main", "jz_r", "jz_l", "solo"] }
                }
              }
            ]
          },
          "char_offset": {
            "type": "integer",
            "minimum": 0,
            "description": "锚点格的字下标缓存：同章 char 读序的 0 起下标（spec/00 §四·2）"
          },
          "pre_char": {
            "type": "string",
            "description": "锚点那一格上的字（after、before 标点都核这一格），用于对齐与防御性防错校验"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source": {
            "type": "string",
            "description": "产出方 <类>:<名>，如 glm:glm-4.5-flash、rule:reflow、claude:manual、human:<人>"
          }
        }
      }
    }
  }
}
