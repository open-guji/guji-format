{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-guji.org/schema/punct/v0.1.json",
  "title": "GujiPunct",
  "description": "伴生层独立外挂标点格式 (guji-punct v0.1)",
  "type": "object",
  "required": ["$schema", "version", "book_id", "punctuations"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "book_id": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "creator": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "base_edition": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "punctuations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["mark"],
        "properties": {
          "id": { "type": "string" },
          "mark": {
            "type": "string",
            "description": "标点符号文本，如 '，'、'。'、'「'、'」'、'《'、'》' 等"
          },
          "kind": {
            "type": "string",
            "enum": ["point", "break", "range"],
            "default": "point",
            "description": "标记类型：point(句逗标点), break(自然段分段符), range(书名号/引号区间)"
          },
          "pos": {
            "type": "string",
            "enum": ["after", "before", "range"],
            "default": "after"
          },
          "anchor": {
            "description": "基于格位的拓扑锚点。支持字符串键 '册:页:列:格' 或结构化对象，抬头超出上框时格位可为负数",
            "oneOf": [
              {
                "type": "string",
                "pattern": "^\\d+:\\d+:\\d+:-?\\d+[ab]?$"
              },
              {
                "type": "object",
                "required": ["page", "line", "slot"],
                "properties": {
                  "volume": { "type": "integer", "minimum": 1 },
                  "page": { "type": "integer", "minimum": 1 },
                  "line": { "type": "integer", "minimum": 1 },
                  "slot": { "type": "integer", "description": "格位，抬头超框时可为负数" },
                  "lane": { "type": "string", "enum": ["main", "jz_r", "jz_l", "solo"] }
                }
              }
            ]
          },
          "char_offset": {
            "type": "integer",
            "minimum": 0,
            "description": "基于线性字符流的绝对偏移量（不计空格/换行）"
          },
          "pre_char": {
            "type": "string",
            "description": "锚点前一个文字字符，用于对齐与防御性防错校验"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source": {
            "type": "string",
            "description": "标点产生源，例如 'llm:qwen-plus' 或 'human'"
          }
        }
      }
    }
  }
}
